# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database (leave blank to use local SQLite)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email backend: console | smtp | sendgrid
EMAIL_BACKEND_TYPE=console
DEFAULT_FROM_EMAIL=no-reply@demobuy.local

# Gmail SMTP (used when EMAIL_BACKEND_TYPE=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# SendGrid (used when EMAIL_BACKEND_TYPE=sendgrid)
SENDGRID_API_KEY=

# Google OAuth (django-allauth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# WhatsApp checkout number (international format, no + or spaces)
WHATSAPP_NUMBER=2348072552365
